# Lokal in .env kopieren, in Netlify unter
# Site settings -> Environment variables eintragen.

# Passwort für /dashboard.html. Ohne diese Variable ist das Dashboard zu.
DASHBOARD_PASSWORD=

# Discord-Webhook für die Benachrichtigung bei neuen Anfragen.
# Optional - fehlt sie, wird die Anfrage trotzdem gespeichert.
DISCORD_WEBHOOK_URL=
